# ===== 密钥与环境变量（严禁入库，本仓库为 public） =====
.env
.env.*
*.pem
*.key
*.keystore
*credentials*
*secret*
*.token
secrets.*
# 例外：源码文件不是密钥。领域源码（如 crates/aether-core/src/credentials.rs、
# src/components/HudCredentialsPane.tsx）必须入库，不能被上面的通配吞掉。
!**/*.rs
!**/*.ts
!**/*.tsx

# ===== Rust / Tauri =====
/target/
**/target/
src-tauri/target/
src-tauri/gen/
**/*.rs.bk

# ===== 前端 =====
node_modules/
dist/
build/
*.local

# ===== 本地数据（SQLite 数据库不落库） =====
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ===== 系统/编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# research subagent worktrees
.worktrees/

# 外部参考 demo（含其可能带入的 env，严禁入库）
demo-gemini2/
.demo-gemini2/

