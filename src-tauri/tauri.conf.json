{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AetherHUD",
  "version": "0.1.0",
  "identifier": "io.github.kostya-sec.aetherhud",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5789",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherHUD",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "noRedirectionBitmap": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../taxonomy.json": "taxonomy.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}